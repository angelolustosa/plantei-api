# .env.example - Configurações do Ambiente
NODE_ENV=development

# Banco de Dados PostgreSQL (Padrão Sequelize no plantei-api)
BASE_URL_DB=postgresql://postgres:postgrespassword@localhost:5432/plantei_db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/plantei_db

# Segurança e Autenticação
JWT_SECRET=defina_uma_chave_aleatoria_com_mais_de_32_caracteres
JWT_EXPIRATION=1d

# Cache Distribuído com Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379